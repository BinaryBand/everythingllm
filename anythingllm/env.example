# Keys in the live /app/server/.env (placeholders only; real values stay out of git).
# Most are written by AnythingLLM's settings pages.

# Chat model provider: openrouter, ollama, deepseek, ... (LLM Preference page)
LLM_PROVIDER=openrouter
# Ollama server and model, when it is the chat or embedding provider
OLLAMA_BASE_PATH=http://ollama-host:11434
OLLAMA_MODEL_PREF=model-name
# How long Ollama keeps a model loaded after a request, in seconds
OLLAMA_KEEP_ALIVE_TIMEOUT=300
# OpenRouter key and chat model (provider/model)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_PREF=provider/model-name
# How long a streamed OpenRouter reply may go quiet before it's treated as done, in ms
OPENROUTER_TIMEOUT_MS=500
# OpenRouter service tier to request (as set on the LLM Preference page)
OPENROUTER_SERVICE_TIER=
# DeepSeek key and model; the deep-research workers call DeepSeek directly
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL_PREF=deepseek-chat
# Z.AI (GLM) through the Generic OpenAI provider. A GLM Coding Plan key only works on
# the coding endpoint, which AnythingLLM's own Z.AI provider doesn't use. The
# deep-research planner (glm-*) uses this key when the base path is Z.AI's.
GENERIC_OPEN_AI_BASE_PATH=https://api.z.ai/api/coding/paas/v4
GENERIC_OPEN_AI_API_KEY=...
GENERIC_OPEN_AI_MODEL_PREF=glm-5.3-flash
# Z.AI key from the built-in Z.AI provider; deep-research's fallback when the
# Generic OpenAI provider points elsewhere
ZAI_API_KEY=...

# Embedding provider, server, model and chunk size (Embedding Preference page)
EMBEDDING_ENGINE=ollama
EMBEDDING_BASE_PATH=http://ollama-host:11434
EMBEDDING_MODEL_PREF=embedding-model-name
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=8192
# Chunks sent to Ollama per embedding request
OLLAMA_EMBEDDING_BATCH_SIZE=1
# Vector database (lancedb is AnythingLLM's built-in one)
VECTOR_DB=lancedb

# SearXNG search URL for agent web search (see README, SearXNG); research-runner uses 127.0.0.1:8888 on the host
AGENT_SEARXNG_API_URL=https://searxng-host:8888/search
# Most tool calls the agent may make in one turn
AGENT_MAX_TOOL_CALLS=40
# AnythingLLM gives the agent only the tools that best match each message (default 15).
# With ~75 tools, short follow-ups ("add Morbid now?") lost the podcast, Gmail or search
# tools and the agent said it couldn't. Keep this above the tools a chat actually uses;
# turning built-in skills nobody uses off (Agent Skills page) keeps the rest in range.
AGENT_SKILL_RERANKER_TOP_N=35

# AnythingLLM's storage inside the container
STORAGE_DIR=/app/server/storage
# Random secrets AnythingLLM uses to sign and encrypt; generate, never share
SIG_KEY=
SIG_SALT=
