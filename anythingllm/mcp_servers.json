{
  "mcpServers": {
    "sites": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--no-dev",
        "--project",
        "/mcp",
        "--package",
        "sites",
        "sites-mcp"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "/app/server/storage/everythingllm/mcp/venv",
        "UV_CACHE_DIR": "/app/server/storage/everythingllm/mcp/uv-cache",
        "UV_PYTHON_DOWNLOADS": "never"
      }
    }
  }
}
