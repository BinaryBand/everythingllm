# The pages site (:8445) and the workspace pages site (:8447), both served by static_agent
# (quadlet/static_agent.container.in) on 127.0.0.1 and routed over HTTPS by the machine (apps.toml).
# default-src 'self' keeps every fetch on the page's own host, so CSS can't send anything
# elsewhere. form-action and base-uri 'none': default-src doesn't cover them, and nothing here
# needs a form, so markup the agent writes can't post anywhere or repoint relative links.
{
  auto_https off
  admin off
}

# The system sites (news and research: Zola, built from the repo's templates) and the link
# cards. No scripts, no inline styles.
:8445 {
  root * /srv/site
  # Workspace pages moved to :8447 on 2026-10-06; the front page and education's old
  # addresses point there.
  redir / https://{$PUBLIC_HOST:127.0.0.1}:8447/
  redir /lab/* https://{$PUBLIC_HOST:127.0.0.1}:8447/education{uri}
  redir /knowledge-protocol-guide/* https://{$PUBLIC_HOST:127.0.0.1}:8447/education{uri}
  header Content-Security-Policy "default-src 'self'; script-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
  header X-Content-Type-Options nosniff
  # A link card asked for in the light theme (&theme=light after its ?v=) is the
  # <name>.light.png chatimage.card saves beside it; a card drawn before there were two
  # stays dark.
  @lightcard {
    path_regexp lightcard ^/_cards/([^/.]+)\.png$
    query theme=light
  }
  route @lightcard {
    try_files /_cards/{re.lightcard.1}.light.png {path}
  }
  file_server {
    hide .zola-site
  }
}

# Every sandbox workspace's /public (sandbox.runner), served as it is: /<workspace>/... is
# that workspace's, whatever it put there, live the moment it's written. The folder mounted
# here holds nothing but /public folders, so a symlink in one can't reach anything private.
# A port of its own makes these pages an origin of their own: whatever they run can't post
# to /news/write on :8445.
# Pages may run inline scripts and scripts from this site, but only in a CSP sandbox: each
# page gets an opaque origin, so it can't use storage or cookies, read the site's other
# pages or files, submit forms, open windows or tabs, or show alert()s; downloads work.
# Never add allow-same-origin (one workspace's scripts could then read every other's
# pages), allow-forms or allow-popups. packages/sandbox/tests/test_pages_browser.py checks
# this in a real browser.
:8447 {
  root * /srv/workspaces
  header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; sandbox allow-scripts allow-downloads"
  header X-Content-Type-Options nosniff
  file_server browse {
    hide .*
  }
}
