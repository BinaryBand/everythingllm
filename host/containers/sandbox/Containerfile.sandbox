# The image every sandbox run starts from. The root filesystem is mounted read-only; /work
# is the thread's scratch folder and /project the workspace's, so pip installs land in
# /project/.local and last as long as the workspace.
# The only way out is sandbox-proxy at 10.89.77.2 (host/systemd/sandbox-proxy.service).
FROM docker.io/library/python:3.13-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash coreutils curl git procps \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir numpy pandas matplotlib requests

# zola, for sites the agent builds (the lab, in education's /shared): the same version as the host's
# /usr/local/bin/zola, so the theme's Tera 2 components behave as they do in sites-runner.
ARG ZOLA_VERSION=0.23.6
ARG ZOLA_SHA256=8f5132b3522412d04e395e0b25f6d68613ad272a873e54a2b3ebf664873024a4
RUN curl -fsSL -o /tmp/zola.tar.gz \
      "https://github.com/getzola/zola/releases/download/v${ZOLA_VERSION}/zola-v${ZOLA_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
 && echo "${ZOLA_SHA256}  /tmp/zola.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/zola.tar.gz -C /usr/local/bin zola \
 && rm /tmp/zola.tar.gz \
 && zola --version

ENV HOME=/work \
    PYTHONUSERBASE=/project/.local \
    PIP_USER=1 \
    PIP_CACHE_DIR=/tmp/pip \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    MPLBACKEND=Agg \
    http_proxy=http://10.89.77.2:8888 \
    https_proxy=http://10.89.77.2:8888 \
    PATH=/project/.local/bin:/usr/local/bin:/usr/bin:/bin
WORKDIR /work
