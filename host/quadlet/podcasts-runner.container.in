[Unit]
Description=Podcasts runner, in its service container: does what the podcasts MCP server's tools ask (socket in storage/everythingllm/podcasts/)
# Its only way out (find_podcast's searches, add_podcast's feed checks), which its venv's
# first sync needs too.
Wants=egress-proxy.service
After=egress-proxy.service
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Container]
Image=localhost/everythingllm-service
Exec=uv run --frozen --no-dev --project @REPO@ --package podcasts --extra host podcasts-runner
# The service containers' hardening (README, "Service containers"). It writes its socket
# in storage, so it keeps the host user's groups (the anythingllm group).
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id
GroupAdd=keep-groups
# Tool calls only: a feed or a page at a time, JSON files, and a gc after remove_podcast.
PidsLimit=256
PodmanArgs=--memory=1g --cpus=1 --umask=0002
RunInit=true
Timezone=local
# egress-net only, at its address in egress.toml (profile podcasts: public hosts).
Network=egress-net:ip=10.89.79.13
Environment=HTTPS_PROXY=http://10.89.79.2:3128
Environment=HTTP_PROXY=http://10.89.79.2:3128
Environment=EGRESS_PROXY=http://10.89.79.2:3128
# Everything at its host path. The repo, read-only.
Volume=@REPO@:@REPO@:ro
# Its venv and uv's cache, in one folder (one mount, so uv can hardlink from the cache).
Volume=%h/.local/share/everythingllm/venvs/podcasts-runner-ctr:%h/.local/share/everythingllm/venvs/podcasts-runner-ctr
Environment=HOME=%h
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/podcasts-runner-ctr/venv
Environment=UV_CACHE_DIR=%h/.local/share/everythingllm/venvs/podcasts-runner-ctr/uv-cache
# The podcasts' state (PODCASTS_STATE): subscriptions, records, the queue the workers take
# syncs from, and what remove_podcast deletes (audio, prints, transcripts, manifests).
Volume=%h/.local/share/everythingllm/podcasts:%h/.local/share/everythingllm/podcasts
# The served folder (PODCASTS_DIR): the index, and a removed show's feed.
Volume=%h/.local/share/everythingllm/pages/public/podcasts:%h/.local/share/everythingllm/pages/public/podcasts
# Its socket's folder. No AnythingLLM .env: the runner asks no model.
Volume=@ANYTHINGLLM_STORAGE@/everythingllm/podcasts:@ANYTHINGLLM_STORAGE@/everythingllm/podcasts
# ANYTHINGLLM_STORAGE, PUBLIC_HOST (the private feeds' URLs) and PODCASTS_*.
EnvironmentFile=@REPO@/host.env

[Service]
# podman won't bind-mount what isn't there.
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/everythingllm/venvs/podcasts-runner-ctr %h/.local/share/everythingllm/podcasts %h/.local/share/everythingllm/pages/public/podcasts @ANYTHINGLLM_STORAGE@/everythingllm/podcasts
# It only asks for syncs (podcasts/queue/), which podcasts-sync-worker runs, so a restart
# stops none.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
