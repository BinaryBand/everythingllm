[Unit]
Description=Podcast sync worker, in its service container: runs the syncs podcasts-runner asks for, and every feed's every 6 hours
# Its only way out (feeds, episodes, DeepSeek for feeds' rules), which its venv's first
# sync needs too.
Wants=egress-proxy.service
After=egress-proxy.service
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Container]
Image=localhost/everythingllm-service
# Takes the syncs asked for from ~/.local/share/everythingllm/podcasts/queue/ one at a
# time, under sync.lock, and asks for every feed's itself at 00:00, 06:00, 12:00 and 18:00
# (podcasts.sync). Each sync's output goes to ~/.local/share/everythingllm/podcasts/sync.log,
# which list_podcasts points to; the worker's own lines to the journal.
Exec=uv run --frozen --no-dev --project @REPO@ --package podcasts --extra host podcasts-sync-worker
# The service containers' hardening (README, "Service containers"). It writes only in the
# data dir, which is the host user's, so it needs none of their other groups.
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id
PidsLimit=256
# Looking for ads reads an episode at about 450 MB an hour of audio, in one process; an
# episode over 8 h isn't looked at (podcasts.library.MAX_SCRUB_SECONDS), so 6 GB holds
# the longest it is, with room for the rest.
PodmanArgs=--memory=6g --cpus=2 --umask=0002
RunInit=true
Timezone=local
# SIGTERM stops a sync at its next feed or scrub, or partway through a download, and asks
# for it again; one killed after this anyway is asked for again at the next start
# (queue/running-sync.json).
StopTimeout=60
# egress-net only, at its address in egress.toml (profile podcasts: public hosts).
Network=egress-net:ip=10.89.79.14
Environment=HTTPS_PROXY=http://10.89.79.2:3128
Environment=HTTP_PROXY=http://10.89.79.2:3128
Environment=EGRESS_PROXY=http://10.89.79.2:3129
# Everything at its host path. The repo, read-only.
Volume=@REPO@:@REPO@:ro
# Its venv and uv's cache, in one folder (one mount, so uv can hardlink from the cache).
Volume=%h/.local/share/everythingllm/venvs/podcasts-sync-worker-ctr:%h/.local/share/everythingllm/venvs/podcasts-sync-worker-ctr
Environment=HOME=%h
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/podcasts-sync-worker-ctr/venv
Environment=UV_CACHE_DIR=%h/.local/share/everythingllm/venvs/podcasts-sync-worker-ctr/uv-cache
# The podcasts' state (PODCASTS_STATE): the queue, sync.lock and sync.log, the records, and
# the audio, cuts, manifests and prints a sync writes.
Volume=%h/.local/share/everythingllm/podcasts:%h/.local/share/everythingllm/podcasts
# The served folder (PODCASTS_DIR): feed.xml, transcripts and the index.
Volume=%h/.local/share/everythingllm/pages/public/podcasts:%h/.local/share/everythingllm/pages/public/podcasts
# Its share of AnythingLLM's .env, read-only (ExecStartPre writes it): the DeepSeek key
# and model that read feeds' rules.
Volume=%h/.config/everythingllm/ctr/podcasts-sync-worker.env:%h/.config/everythingllm/ctr/podcasts-sync-worker.env:ro
Environment=ANYTHINGLLM_ENV=%h/.config/everythingllm/ctr/podcasts-sync-worker.env
# ANYTHINGLLM_STORAGE, PUBLIC_HOST (the private feeds' URLs) and PODCASTS_*.
EnvironmentFile=@REPO@/host.env

[Service]
# Its share of AnythingLLM's .env (the DeepSeek key and model that read feeds' rules),
# never the file, which holds every key and secret AnythingLLM has: written on the host
# before each start (hostctl.ctr_env), so a restart takes up a changed key.
ExecStartPre=/usr/bin/env PYTHONPATH=@REPO@/packages/hostctl/src:@REPO@/packages/apps/src /usr/bin/python3 -m hostctl.ctr_env @ANYTHINGLLM_STORAGE@/.env %h/.config/everythingllm/ctr/podcasts-sync-worker.env DEEPSEEK_API_KEY DEEPSEEK_MODEL_PREF
# podman won't bind-mount what isn't there.
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/everythingllm/venvs/podcasts-sync-worker-ctr %h/.local/share/everythingllm/podcasts %h/.local/share/everythingllm/pages/public/podcasts
# It slows down past 5 GB, before the container's 6 GB limit kills it.
MemoryHigh=5G
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
