[Unit]
Description=Nilson relay: owns the Nilson app's chat answers, streaming each from AnythingLLM to the end even when the app goes away (127.0.0.1:8446, tailnet via tailscale serve at https :3001/everythingllm/)
# Its only way out, to AnythingLLM and ntfy; also what uv syncs its venv through.
Wants=egress-proxy.service
After=egress-proxy.service
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Container]
Image=localhost/everythingllm-service
Exec=uv run --frozen --no-dev --project @REPO@ --package relay relay
# The service containers' hardening (README, "Service containers"). It writes nothing in
# storage, so it doesn't keep the host user's groups.
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id
PidsLimit=256
PodmanArgs=--memory=512m --cpus=1 --umask=0002
RunInit=true
Timezone=local
# egress-net only, at its address in egress.toml (profile relay: AnythingLLM and ntfy,
# nothing public), and its port on the host's loopback, where tailscale serve and the
# health check reach it.
Network=egress-net:ip=10.89.79.10
PublishPort=127.0.0.1:8446:8446
# The repo at its host path, read-only; its venv and uv's cache in one folder of the data
# dir; and its database's folder. Nothing else: it has no socket and no storage.
Volume=@REPO@:@REPO@:ro
Volume=%h/.local/share/everythingllm/venvs/relay-ctr:%h/.local/share/everythingllm/venvs/relay-ctr
Volume=%h/.local/share/everythingllm/relay:%h/.local/share/everythingllm/relay
Environment=HOME=%h
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/relay-ctr/venv
Environment=UV_CACHE_DIR=%h/.local/share/everythingllm/venvs/relay-ctr/uv-cache
Environment=HTTPS_PROXY=http://10.89.79.2:3128
Environment=HTTP_PROXY=http://10.89.79.2:3128
Environment=EGRESS_PROXY=http://10.89.79.2:3129
# The host's loopback isn't the container's: AnythingLLM by its tailnet name, which the
# proxy lets the relay reach.
Environment=ANYTHINGLLM_URL=https://@PUBLIC_HOST@:3001
# What comes through the published port arrives from the container's own address, so it
# listens on all of them, and believes tailscale serve's X-Forwarded-* only from that one
# (its address above). Another container on egress-net reaching the port is refused
# (relay.app.LocalPeers).
Environment=RELAY_HOST=0.0.0.0
Environment=FORWARDED_ALLOW_IPS=10.89.79.10
# host.env, then the relay's ntfy settings (NTFY_*, secrets), which
# `uv run hostctl relay-setup` makes. podman reads both on the host and passes their values
# in, so the files aren't mounted; the Environment= lines above win over them.
EnvironmentFile=@REPO@/host.env
EnvironmentFile=%h/.config/everythingllm/relay.env

[Service]
# podman won't bind-mount a folder that isn't there.
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/everythingllm/venvs/relay-ctr
ExecStartPre=/usr/bin/mkdir -p -m 0700 %h/.local/share/everythingllm/relay
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
