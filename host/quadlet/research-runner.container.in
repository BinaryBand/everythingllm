[Unit]
Description=Deep research for the AnythingLLM skill, in its service container (socket in storage/everythingllm/research/)
# Its only way out, which its venv's first sync needs too.
Wants=egress-proxy.service
After=egress-proxy.service
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Container]
Image=localhost/everythingllm-service
Exec=uv run --frozen --no-dev --project @REPO@ --package research research-runner
# The service containers' hardening (README, "Service containers"). It writes in storage,
# so it keeps the host user's groups (the anythingllm group).
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id
GroupAdd=keep-groups
# Two runs at once, each a few dozen threads that mostly wait on the models.
PidsLimit=256
PodmanArgs=--memory=2g --cpus=2 --umask=0002
RunInit=true
Timezone=local
# egress-net only, at its address in egress.toml (profile research: public hosts, SearXNG
# by PUBLIC_HOST, and the ntfy host).
Network=egress-net:ip=10.89.79.11
Environment=HTTPS_PROXY=http://10.89.79.2:3128
Environment=HTTP_PROXY=http://10.89.79.2:3128
Environment=EGRESS_PROXY=http://10.89.79.2:3129
# The live cards, on the host's 127.0.0.1:8450 as before; inside, they listen on every
# address, since what's published arrives from the container's own, and answer only that
# one and loopback (hostrpc.local_peer), not another container on egress-net.
PublishPort=127.0.0.1:8450:8450
Environment=LIVE_HOST=0.0.0.0
# The host's loopback isn't reachable from here: SearXNG by PUBLIC_HOST, through the
# proxy. Not AnythingLLM, so it holds no AnythingLLM login.
Environment=SEARXNG_URL=https://@PUBLIC_HOST@:8888/search
# Everything at its host path. The repo, read-only (the code, host.env).
Volume=@REPO@:@REPO@:ro
# Its venv and uv's cache, in one folder (one mount, so uv can hardlink from the cache).
Volume=%h/.local/share/everythingllm/venvs/research-runner-ctr:%h/.local/share/everythingllm/venvs/research-runner-ctr
Environment=HOME=%h
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/research-runner-ctr/venv
Environment=UV_CACHE_DIR=%h/.local/share/everythingllm/venvs/research-runner-ctr/uv-cache
# The run log and live runs' markers (the run guard reads them on the host).
Volume=%h/.local/share/everythingllm/research:%h/.local/share/everythingllm/research
# Its socket's folder.
Volume=@ANYTHINGLLM_STORAGE@/everythingllm/research:@ANYTHINGLLM_STORAGE@/everythingllm/research
# Its share of AnythingLLM's .env, read-only (ExecStartPre writes it): the model keys, never
# AnythingLLM's password or JWT secret.
Volume=%h/.config/everythingllm/ctr/research-runner.env:%h/.config/everythingllm/ctr/research-runner.env:ro
Environment=ANYTHINGLLM_ENV=%h/.config/everythingllm/ctr/research-runner.env
# Where the report is saved, for the agent's files and for agents-runner to add to the
# workspace's documents.
Volume=@ANYTHINGLLM_STORAGE@/anythingllm-fs/research:@ANYTHINGLLM_STORAGE@/anythingllm-fs/research
# ANYTHINGLLM_STORAGE, PUBLIC_HOST and USER_TIMEZONE.
EnvironmentFile=@REPO@/host.env
# The relay's ntfy topic and token (NTFY_URL, NTFY_TOKEN; research.notify), as values podman
# reads on the host, not a file it can see. hostctl.relay_env makes the file.
EnvironmentFile=%h/.config/everythingllm/relay.env

[Service]
# Its share of AnythingLLM's .env (the model keys), never the file, which holds every key
# and secret AnythingLLM has: written on the host before each start (hostctl.ctr_env), so a
# restart takes up a changed key.
ExecStartPre=/usr/bin/env PYTHONPATH=@REPO@/packages/hostctl/src:@REPO@/packages/hostenv/src /usr/bin/python3 -m hostctl.ctr_env @ANYTHINGLLM_STORAGE@/.env %h/.config/everythingllm/ctr/research-runner.env DEEPSEEK_API_KEY DEEPSEEK_MODEL_PREF GENERIC_OPEN_AI_BASE_PATH GENERIC_OPEN_AI_API_KEY ZAI_API_KEY
# podman won't bind-mount what isn't there.
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/everythingllm/venvs/research-runner-ctr %h/.local/share/everythingllm/research @ANYTHINGLLM_STORAGE@/everythingllm/research @ANYTHINGLLM_STORAGE@/anythingllm-fs/research
# A run is mostly waiting on the models; what CPU it takes (page parsing) can give way.
# The container's processes inherit it from podman.
Nice=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
