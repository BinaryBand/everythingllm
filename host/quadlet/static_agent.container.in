[Unit]
Description=Read-only static sites: the pages site (:8445) and the workspace pages site (:8447)

[Container]
Image=docker.io/library/caddy:2-alpine
Volume=%h/.local/share/everythingllm/pages/public:/srv/site:ro,z
# Every sandbox workspace's /public, and nothing else of theirs (sandbox.runner).
Volume=%h/.local/share/everythingllm/sandbox/public:/srv/workspaces:ro,z
# Its CSPs are what keep the pages the agent writes from running scripts (:8445), or
# run them only in a sandbox (:8447).
Volume=@REPO@/host/caddy/pages.Caddyfile:/etc/caddy/Caddyfile:ro,z
# For redirects from the pages site to the workspace pages site.
Environment=PUBLIC_HOST=@PUBLIC_HOST@
PublishPort=127.0.0.1:8445:8445
PublishPort=127.0.0.1:8447:8447

[Service]
# Podman doesn't make a missing bind source, and on a new machine nothing has made the
# sandbox's public/ yet (sandbox-runner makes it with a workspace's first call).
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/everythingllm/pages/public %h/.local/share/everythingllm/sandbox/public
Restart=always

[Install]
WantedBy=default.target
