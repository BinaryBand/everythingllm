[Unit]
Description=Delegation: runs tasks as AnythingLLM's own agents for the delegate skill (socket in storage/everythingllm/agents/)
After=network.target
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=@REPO@/host.env
# Its developer API key (ANYTHINGLLM_API_KEY), outside the repo, which the AnythingLLM
# container mounts; `uv run hostctl agents-setup` checks it.
EnvironmentFile=%h/.config/everythingllm/agents.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/agents
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package agents agents-runner
# uv exits 143 on the SIGTERM that stops it: a clean stop, not a failure.
SuccessExitStatus=143
# A delegation is mostly waiting on AnythingLLM.
Nice=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
