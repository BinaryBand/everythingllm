[Unit]
Description=Audit runner: runs the audit MCP server's health checks on the host (socket in storage/audit/)
After=network.target
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Service]
# The checks' other paths (run logs, .env, the sandbox socket) default to storage's.
EnvironmentFile=@REPO@/host.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/audit-venv
# The tailnet URL the agent's web search uses, so the check covers tailscale serve too.
Environment=SEARXNG_URL=https://@PUBLIC_HOST@:8888/search
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package audit audit-runner
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
