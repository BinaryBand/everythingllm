[Unit]
Description=MCP gateway: the runners' MCP tools over streamable HTTP for clients other than AnythingLLM (127.0.0.1:8452, routed by the machine at https :8452)
After=network.target
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Service]
# The clients' tokens (GATEWAY_TOKEN_<NAME>) live in gateway.env, outside the repo, which
# the AnythingLLM container mounts; `uv run hostctl gateway-setup` makes it.
EnvironmentFile=@REPO@/host.env
EnvironmentFile=%h/.config/everythingllm/gateway.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/gateway
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package gateway gateway
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
