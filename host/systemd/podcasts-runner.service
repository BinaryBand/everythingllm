[Unit]
Description=Podcasts runner: does what the podcasts MCP server's tools ask (socket in storage/podcasts/)
After=network.target
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=@REPO@/host.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/podcasts
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package podcasts --extra host podcasts-runner
# Syncs it starts are units of their own (podcasts-sync@.service), so a restart stops none.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
