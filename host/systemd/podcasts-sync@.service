[Unit]
Description=Podcast sync of %i: download new episodes and cut their ads
After=network.target

[Service]
EnvironmentFile=@REPO@/host.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/podcasts
Type=oneshot
# %i is a feed's slug, or _all for every feed (what the timer starts); podcasts-runner
# starts either for chat. Takes
# ~/.local/share/everythingllm/podcasts/sync.lock itself and exits at once if a sync is already running.
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package podcasts --extra host podcasts-sync %i
# list_podcasts and the runner read the end of it; `make podcasts-logs` follows it.
StandardOutput=append:%h/.local/share/everythingllm/podcasts/sync.log
StandardError=append:%h/.local/share/everythingllm/podcasts/sync.log
