[Unit]
Description=Podcast transcripts worker: transcribes downloaded episodes and looks for sponsor reads, every 6 hours
After=network.target
# Keep retrying after a crash loop instead of giving up for good.
StartLimitIntervalSec=0

[Service]
# PODCASTS_TRANSCRIBE_THREADS is read from host.env again at every pass, so a change there
# needs no restart; unset, it is 1 thread.
EnvironmentFile=@REPO@/host.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/podcasts
# A pass at 00:30, 06:30, 12:30 and 18:30, half an hour after each scheduled sync, or when
# asked (podcasts-transcribe); one at a time, under
# ~/.local/share/everythingllm/podcasts/transcribe.lock (podcasts.transcripts).
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package podcasts --extra host podcasts-transcribe-worker
# Whisper takes every core it's given; anything else goes first.
Nice=19
# Whisper hears episodes in 20-minute windows, decoded as they're heard, so a pass holds
# about one window's audio and features whatever the episode's length (it peaked at 3.5 GB
# on an 8 h one with the whole episode decoded at once). Past MemoryMax the kernel kills
# the worker, not the rest of the host; it starts again, and its first pass marks that
# episode failed (transcribing.json) and goes on with the rest.
MemoryHigh=5G
MemoryMax=6G
# On SIGTERM (a stop, a restart by `uv run hostctl units`, a reboot) a pass removes
# transcribing.json and the worker exits 143: not a failure, and not held against the
# episode.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
