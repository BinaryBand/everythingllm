[Unit]
Description=Podcast transcripts: transcribe downloaded episodes and look for sponsor reads
After=network.target

[Service]
# PODCASTS_TRANSCRIBE_THREADS is read from it at every run, so a change there needs no
# `make units`; unset, it is 1 thread.
EnvironmentFile=@REPO@/host.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/podcasts-venv
Type=oneshot
# Takes storage/podcasts/transcribe.lock itself and exits at once if a run is already going.
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package podcasts --extra host podcasts-transcribe
# Whisper takes every core it's given; anything else goes first.
Nice=19
# Whisper hears episodes in 20-minute windows, decoded as they're heard, so a run holds
# about one window's audio and features whatever the episode's length (it peaked at 3.5 GB
# on an 8 h one with the whole episode decoded at once). Past MemoryMax the kernel kills
# this run, not the rest of the host, and the next run marks that episode failed
# (transcribing.json).
MemoryHigh=5G
MemoryMax=6G
# On SIGTERM (a stop, a restart by `make units`, a reboot) the run removes transcribing.json
# and exits 143: not a failure, and not held against the episode.
SuccessExitStatus=143
