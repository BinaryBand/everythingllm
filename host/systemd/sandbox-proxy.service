[Unit]
Description=Code sandbox proxy: the sandboxes' only way out, to PyPI (src/mcps/sandbox/containers/allowlist)

[Service]
ExecStart=/usr/bin/podman run --rm --replace --name sandbox-proxy --network sandbox-net:ip=10.89.77.2 --network podman localhost/anything-sandbox-proxy
ExecStop=/usr/bin/podman stop -t 5 sandbox-proxy
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
