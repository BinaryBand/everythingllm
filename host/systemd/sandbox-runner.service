[Unit]
Description=Code sandbox and page publisher for AnythingLLM's run-code, write-file and publish skills (socket in storage/everythingllm/sandbox/)
# Its runs' only way out, to PyPI (egress.toml's sandbox profile).
After=egress-proxy.service
Wants=egress-proxy.service

[Service]
EnvironmentFile=@REPO@/host.env
Environment=UV_PROJECT_ENVIRONMENT=%h/.local/share/everythingllm/venvs/sandbox
ExecStart=/usr/local/bin/uv run --frozen --no-dev --project @REPO@ --package sandbox sandbox-runner
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
